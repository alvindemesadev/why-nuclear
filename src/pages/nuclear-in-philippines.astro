    <script is:inline>
      // Theme toggle: flip data-theme and remember the choice (same as the
      // other pages; the <head> script resolved the initial theme).
      var themeToggle = document.getElementById("theme-toggle");
      if (themeToggle) {
        var syncToggle = function (theme) {
          themeToggle.setAttribute("aria-pressed", String(theme === "dark"));
          themeToggle.setAttribute(
            "aria-label",
            theme === "dark" ? "Switch to light theme" : "Switch to dark theme"
          );
        };
        var applyTheme = function (theme, persist) {
          document.documentElement.setAttribute("data-theme", theme);
          if (persist) {
            try {
              localStorage.setItem("theme", theme);
            } catch (e) {}
          }
          syncToggle(theme);
        };
        syncToggle(document.documentElement.getAttribute("data-theme") || "dark");
        themeToggle.addEventListener("click", function () {
          var current = document.documentElement.getAttribute("data-theme");
          applyTheme(current === "dark" ? "light" : "dark", true);
        });
      }

      // Mobile menu: close when a link is chosen or Escape is pressed.
      var navToggle = document.getElementById("nav-toggle");
      if (navToggle) {
        document.querySelectorAll(".nav-panel a").forEach(function (a) {
          a.addEventListener("click", function () {
            navToggle.checked = false;
          });
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") navToggle.checked = false;
        });
      }

      // Scrollspy: highlight the nav link for the deep-dive section in view
      // and mirror it into the URL hash (replaceState — no history spam, no
      // scroll jump; the hero clears the hash). Same behavior as the main
      // article. Without JS the page simply skips the highlight.
      if ("IntersectionObserver" in window) {
        var links = Array.prototype.slice.call(document.querySelectorAll(".nav-links a"));
        var ids = links.map(function (l) {
          return l.getAttribute("href").slice(1);
        });
        var sections = ids
          .map(function (id) {
            return document.getElementById(id);
          })
          .filter(Boolean);
        // NB: the variable must NOT be named `top` — at global scope that
        // collides with the built-in window.top (the topmost window), the
        // assignment silently fails, and observe() throws.
        var hero = document.getElementById("top");
        if (hero) sections.push(hero);
        var setActive = function (id) {
          links.forEach(function (l) {
            l.classList.toggle("active", l.getAttribute("href") === "#" + id);
          });
        };
        var setHash = function (id) {
          try {
            if (id === "top") {
              if (location.hash) history.replaceState(null, "", location.pathname + location.search);
            } else if (location.hash !== "#" + id) {
              history.replaceState(null, "", "#" + id);
            }
          } catch (e) {}
        };
        var spy = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                setActive(e.target.id);
                setHash(e.target.id);
              }
            });
          },
          { rootMargin: "-40% 0px -55% 0px" }
        );
        sections.forEach(function (s) {
          spy.observe(s);
        });

        // Deep links: light up the target nav link immediately, before the
        // observer's first callbacks (which fire while the browser's own
        // fragment scroll is still settling). Adopt on hashchange too, and on
        // any nav-link click.
        var adoptFromHash = function () {
          var id = location.hash.slice(1);
          if (id && sections.indexOf(document.getElementById(id)) !== -1) {
            setActive(id);
          }
        };
        adoptFromHash();
        window.addEventListener("hashchange", adoptFromHash);
        document.querySelectorAll(".nav-links a, .nav-panel a").forEach(function (a) {
          a.addEventListener("click", adoptFromHash);
        });

        // Belt-and-suspenders for the very top of the page: the observer
        // tracks the hero like every other section, and a passive scroll
        // listener guarantees the hash clears deterministically at scrollY 0.
        window.addEventListener(
          "scroll",
          function () {
            if (window.scrollY <= 1) {
              setActive("top");
              setHash("top");
            }
          },
          { passive: true }
        );

        // Back-to-top links (brand, footer) must never put "#top" in the
        // URL: intercept the click, smooth-scroll instead, and clear any
        // hash already present.
        document.addEventListener("click", function (e) {
          var a = e.target.closest ? e.target.closest('a[href="#top"]') : null;
          if (a) {
            e.preventDefault();
            setActive("top");
            setHash("top");
            window.scrollTo({ top: 0, behavior: "smooth" });
          }
        });

        // Landing on /#top (a shared link) should settle to a clean URL once
        // the browser's own fragment scroll has finished.
        window.addEventListener("load", function () {
          if (location.hash === "#top") {
            setActive("top");
            setHash("top");
            return;
          }
          // Adopt whichever section the browser actually landed on: covers
          // scroll-restored reloads and any fragment scroll still finishing
          // when the observer's first callbacks ran.
          var bandTop = window.innerHeight * 0.4;
          var bandBottom = window.innerHeight * 0.45;
          var best = null;
          sections.forEach(function (s) {
            var r = s.getBoundingClientRect();
            if (r.top <= bandBottom && r.bottom >= bandTop && (!best || r.top < best.top)) {
              best = { el: s, top: r.top };
            }
          });
          if (best) {
            setActive(best.el.id);
            setHash(best.el.id);
          }
        });
      }
    </script>
